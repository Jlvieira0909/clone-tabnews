  "license": "MIT",
  "dependencies": {
    "docker": "^1.0.0",
    "next": "^15.1.0",
    "pg": "^8.11.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "jest": "^29.6.2"
  }
}
